{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "cleanUrls": true,
  "functions": {
    "api/connectome.py": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": ["public/data/flywire-v783.npz", "public/data/manifest.json"]
    },
    "api/sleep.py": { "maxDuration": 60, "memory": 1024 }
  },
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
