{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "cleanUrls": true,
  "functions": {
    "api/sleep.py": { "maxDuration": 60, "memory": 1024 },
    "api/connectome.py": { "maxDuration": 60, "memory": 1024, "includeFiles": "public/data/**" }
  },
  "redirects": [
    { "source": "/connectome", "destination": "/", "permanent": false },
    { "source": "/datasets", "destination": "/#integrity", "permanent": false }
  ],
  "headers": [
    {
      "source": "/NeuroMLCR.zip",
      "headers": [{ "key": "Content-Disposition", "value": "attachment; filename=NeuroMLCR.zip" }]
    }
  ]
}
